# PostgreSQL connection string (Supabase)
# Reemplaza TU_PASSWORD y TU_PROJECT_ID con los datos de Supabase
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@db.TU_PROJECT_ID.supabase.co:5432/postgres

# JWT
# Genera uno con:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=TU_SECRETO_JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
# Dominios permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Recuperación de contraseña
# FRONTEND_URL: base del frontend (se arma el enlace /reset-password?token=...)
FRONTEND_URL=http://localhost:5173
# Duración del token de recuperación
RESET_TOKEN_EXPIRE_MINUTES=60
# SMTP (opcional). Sin estas variables el enlace NO se envía por correo:
# se registra en el log del backend en modo desarrollo para poder probar.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=True